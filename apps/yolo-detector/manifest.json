{
  "id": "yolo-detector",
  "name": "YOLO Detector",
  "version": "0.1.0",
  "image": "/appcenter/apps/yolo-detector.png",
  "type": "self-hosted",
  "description": "General-purpose object detection over the live camera. Runs YOLOv8n (COCO-80) on the RV1126B NPU and streams structured detections for the /appcenter overlay.",
  "author": "Seeed reCamera Pro",
  "entry": "app.py",
  "kit": ">=0.1.0",
  "interpreter": "/userdata/rknnenv/bin/python",
  "models": [
    {
      "id": "yolo8n_rawhead_int8",
      "file": "models/yolo8n_rawhead_int8.rknn",
      "task": "detect",
      "input": [
        1,
        640,
        640,
        3
      ],
      "quant": "int8",
      "classes": "coco80"
    }
  ],
  "postproc": "detect",
  "pipeline": [
    {
      "model": "yolo8n_rawhead_int8",
      "postproc": "detect"
    }
  ],
  "output": {
    "sink": "ws",
    "port": 8124,
    "schema": "results[]{box,cls,cls_name,score} + events[]{kind,label,cls,score,box}"
  },
  "config_schema": {
    "conf": {
      "type": "number",
      "title": "Confidence threshold",
      "default": 0.35,
      "min": 0.05,
      "max": 0.95,
      "step": 0.05
    },
    "iou": {
      "type": "number",
      "title": "NMS IoU threshold",
      "default": 0.45,
      "min": 0.1,
      "max": 0.9,
      "step": 0.05
    }
  },
  "ha_entities": [
    {
      "component": "sensor",
      "object_id": "detection_count",
      "name": "Detection Count",
      "value_template": "{{ value_json.results_count }}",
      "state_class": "measurement",
      "icon": "mdi:eye"
    },
    {
      "component": "binary_sensor",
      "object_id": "person_occupancy",
      "name": "Person Detected",
      "value_template": "{{ 'ON' if value_json.class_counts.person is defined and value_json.class_counts.person > 0 else 'OFF' }}",
      "device_class": "occupancy"
    }
  ]
}
