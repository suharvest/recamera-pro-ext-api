{
  "id": "yolo-detector",
  "name": "YOLO Detector",
  "version": "0.1.0",
  "image": "/appcenter/apps/yolo-detector.png",
  "type": "self-hosted",
  "description": "General-purpose object detection over the live camera. Runs YOLOv8n (COCO-80) on the RV1126B NPU and streams structured detections for the /appcenter overlay.",
  "author": "Seeed reCamera Pro",
  "entry": "app.py",
  "kit": ">=0.1.0",
  "interpreter": "/userdata/rknnenv/bin/python",
  "capabilities": [
    "output"
  ],
  "models": [
    {
      "id": "yolo8n_rawhead_int8",
      "file": "models/yolo8n_rawhead_int8.rknn",
      "task": "detect",
      "input": [
        1,
        640,
        640,
        3
      ],
      "quant": "int8",
      "classes": "coco80"
    }
  ],
  "postproc": "detect",
  "output": {
    "sink": "ws",
    "port": 8124,
    "schema": "results[]{box,cls,cls_name,score} + events[]{kind,label,cls,score,box}",
    "default_channel": [
      "ws"
    ],
    "default_mode": "raw",
    "fields": [
      {"name": "box", "from": "results[].box", "type": "bbox<float>[4]", "coord": "pixel_xyxy", "description": "Detection box, original-frame xyxy pixels"},
      {"name": "cls", "from": "results[].cls", "type": "integer", "description": "COCO-80 class id"},
      {"name": "cls_name", "from": "results[].cls_name", "type": "string", "description": "COCO-80 class label"},
      {"name": "score", "from": "results[].score", "type": "float", "description": "Detection confidence"},
      {"name": "detection_kind", "from": "events[kind=detection].kind", "type": "string", "event_kind": "detection", "description": "Event kind, always 'detection'"},
      {"name": "detection_label", "from": "events[kind=detection].label", "type": "string", "event_kind": "detection", "description": "Class label of the detection event"},
      {"name": "detection_cls", "from": "events[kind=detection].cls", "type": "integer", "event_kind": "detection", "description": "Class id of the detection event"},
      {"name": "detection_score", "from": "events[kind=detection].score", "type": "float", "event_kind": "detection", "description": "Confidence of the detection event"},
      {"name": "detection_box", "from": "events[kind=detection].box", "type": "bbox<float>[4]", "coord": "pixel_xyxy", "event_kind": "detection", "description": "Box of the detection event"}
    ],
    "default_mapping": [
      {"source": "detection.count", "target": "count", "topic": "recamera/{{ app }}/count", "task": "detection"},
      {"source": "detection.entries | selectattr('label','equalto','person') | list | length", "target": "person_count", "topic": "recamera/{{ app }}/count", "task": "detection"},
      {"source": "detection.entries", "target": "detections", "topic": "recamera/{{ app }}/detections", "task": "detection"}
    ]
  },
  "config_schema": {
    "conf": {
      "type": "number",
      "apply": "live",
      "title": "Confidence threshold",
      "default": 0.35,
      "min": 0.05,
      "max": 0.95,
      "step": 0.05
    },
    "iou": {
      "type": "number",
      "apply": "live",
      "title": "NMS IoU threshold",
      "default": 0.45,
      "min": 0.1,
      "max": 0.9,
      "step": 0.05
    }
  },
  "ha_entities": [
    {
      "component": "sensor",
      "object_id": "detection_count",
      "name": "Detection Count",
      "value_template": "{{ value_json.results_count }}",
      "state_class": "measurement",
      "icon": "mdi:eye"
    },
    {
      "component": "binary_sensor",
      "object_id": "person_occupancy",
      "name": "Person Detected",
      "value_template": "{{ 'ON' if value_json.class_counts.person is defined and value_json.class_counts.person > 0 else 'OFF' }}",
      "device_class": "occupancy"
    }
  ]
}
