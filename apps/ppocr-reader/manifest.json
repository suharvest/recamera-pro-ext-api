{
  "id": "ppocr-reader",
  "name": "PP-OCR Reader",
  "name_zh": "文字识别",
  "version": "0.1.0",
  "image": "/appcenter/apps/ppocr-reader.png",
  "type": "self-hosted",
  "scene": "OCR & Text",
  "scene_zh": "文字识别",
  "description": "On-device OCR text reader: a DBNet detector (PP-OCRv3, 480x480) finds every text region, each region is perspective-cropped to an upright 48x320 strip, then a CTC recognizer (SVTR-LCNet, 6625-class Chinese+English dictionary) reads the characters. Emits one event per text box with the recognized string, its quad and confidence. Everything runs on-device; no image or text leaves the camera. Port of the first-gen SSCMA ppocr-reader C++ solution to the reCamera Pro Python kit.",
  "description_zh": "设备端 OCR 文字识别：DBNet 检测器（PP-OCRv3，480x480）找出每个文本区域，逐区域透视裁剪为竖直的 48x320 文本条，再由 CTC 识别器（SVTR-LCNet，6625 类中英文字典）解码字符。每个文本框输出一条事件，包含识别文本、四点框与置信度。全流程设备端运行，图像与文本均不出设备。一代 SSCMA ppocr-reader C++ 方案到 reCamera Pro Python kit 的移植。",
  "author": "Seeed reCamera Pro",
  "entry": "app.py",
  "kit": ">=0.1.0",
  "models": [
    {
      "id": "ppocr_det_fp16",
      "file": "models/ppocr_det_fp16.rknn",
      "task": "detect",
      "input": [
        1,
        480,
        480,
        3
      ],
      "quant": "fp16",
      "norm": "imagenet-baked",
      "output": "db-probmap-1x1x480x480",
      "role": "stage1_det"
    },
    {
      "id": "ppocr_rec_fp16",
      "file": "models/ppocr_rec_fp16.rknn",
      "task": "recognize",
      "input": [
        1,
        48,
        320,
        3
      ],
      "quant": "fp16",
      "norm": "minusone-to-one-baked",
      "output": "ctc-logits-1x40x6625",
      "dict": "models/ppocr_keys_v1.txt",
      "role": "stage2_rec"
    }
  ],
  "default_model": "ppocr_det_fp16",
  "postproc": "db_ocr",
  "pipeline": [
    {
      "model": "ppocr_det_fp16",
      "postproc": "db_ocr",
      "stage": "detect",
      "input_size": 480
    },
    {
      "model": "ppocr_rec_fp16",
      "postproc": "ctc",
      "stage": "roi_recognize",
      "input_size": [
        48,
        320
      ]
    }
  ],
  "output": {
    "sink": "ws",
    "port": 8124,
    "schema": "results[]{box,quad,score,text,rec_conf,kind=text} + events[]{kind=text,box,quad,text,score,rec_conf}",
    "topic": "recamera/ppocr-reader/results"
  },
  "config_schema": {
    "groups": [
      {
        "key": "detection",
        "title": "Text detection",
        "title_zh": "文本检测",
        "items": [
          {
            "key": "det_thresh",
            "type": "number",
            "title": "Prob-map threshold",
            "title_zh": "概率图阈值",
            "min": 0.1,
            "max": 0.9,
            "step": 0.05,
            "default": 0.3
          },
          {
            "key": "box_thresh",
            "type": "number",
            "title": "Box score threshold",
            "title_zh": "文本框阈值",
            "min": 0.1,
            "max": 0.95,
            "step": 0.05,
            "default": 0.5
          },
          {
            "key": "unclip_ratio",
            "type": "number",
            "title": "Unclip ratio",
            "title_zh": "外扩膨胀比",
            "min": 1.0,
            "max": 3.5,
            "step": 0.1,
            "default": 2.0
          },
          {
            "key": "max_boxes",
            "type": "number",
            "title": "Max text boxes / frame",
            "title_zh": "每帧最大文本框",
            "min": 1,
            "max": 32,
            "step": 1,
            "default": 8
          }
        ]
      },
      {
        "key": "recognition",
        "title": "Text recognition",
        "title_zh": "文本识别",
        "items": [
          {
            "key": "min_rec_conf",
            "type": "number",
            "title": "Min recognition confidence",
            "title_zh": "识别最低置信度",
            "min": 0.0,
            "max": 0.95,
            "step": 0.05,
            "default": 0.25
          }
        ]
      }
    ]
  },
  "ha_entities": [
    {
      "component": "sensor",
      "object_id": "text_count",
      "name": "Text Block Count",
      "value_template": "{{ value_json.counts_by_kind.text | default(0) }}",
      "state_class": "measurement",
      "icon": "mdi:text-recognition"
    },
    {
      "component": "sensor",
      "object_id": "last_text",
      "name": "Last Recognized Text",
      "value_template": "{{ value_json.summary.text | default('') }}"
    }
  ]
}
